      <aliases enabled='yes' />
      <column caption='High Price Indicator' datatype='boolean' name='[Calculation_3421430292688896]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SCRIPT_BOOL(&#13;&#10;&quot;&#13;&#10;return [x is not None and x &gt; 100 for x in _arg1]&#13;&#10;&quot;,&#13;&#10;ATTR([price])&#13;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Property Category' datatype='string' name='[Calculation_3421430298935298]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SCRIPT_STR(&#13;&#10;&quot;&#13;&#10;categories = []&#13;&#10;for x in _arg1:&#13;&#10;    if x is None:&#13;&#10;        categories.append(&apos;Unknown&apos;)&#13;&#10;    elif x &lt;= 100:&#13;&#10;        categories.append(&apos;Low&apos;)&#13;&#10;    elif x &lt;= 200:&#13;&#10;        categories.append(&apos;Medium&apos;)&#13;&#10;    else:&#13;&#10;        categories.append(&apos;High&apos;)&#13;&#10;return categories&#13;&#10;&quot;,&#13;&#10;ATTR([price])&#13;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Price Per Review' datatype='real' name='[Calculation_3421430302769155]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SCRIPT_REAL(&#13;&#10;&quot;&#13;&#10;ratios = []&#13;&#10;for price, reviews in zip(_arg1, _arg2):&#13;&#10;    if reviews is None or reviews == 0 or price is None:&#13;&#10;        ratios.append(None)&#13;&#10;    else:&#13;&#10;        ratios.append(price / reviews)&#13;&#10;return ratios&#13;&#10;&quot;,&#13;&#10;ATTR([price]),&#13;&#10;ATTR([number_of_reviews])&#13;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Availability Score' datatype='integer' name='[Calculation_3421430304194564]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SCRIPT_INT(&#13;&#10;&quot;&#13;&#10;scores = []&#13;&#10;for avail in _arg1:&#13;&#10;    if avail is None:&#13;&#10;        scores.append(None)&#13;&#10;    elif avail &lt;= 30:&#13;&#10;        scores.append(1)&#13;&#10;    elif avail &lt;= 90:&#13;&#10;        scores.append(2)&#13;&#10;    elif avail &lt;= 180:&#13;&#10;        scores.append(3)&#13;&#10;    elif avail &lt;= 300:&#13;&#10;        scores.append(4)&#13;&#10;    else:&#13;&#10;        scores.append(5)&#13;&#10;return scores&#13;&#10;&quot;,&#13;&#10;ATTR([availability_365])&#13;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
