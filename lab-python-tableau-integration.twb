      <column caption='High Price Indicator Tabpy_f1' datatype='boolean' name='[Calculation_899031098511261696]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SCRIPT_BOOL(&quot;&#10;return _arg1[0] &gt; 100&#10;&quot;,&#10;SUM([price])&#10;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Property Category Tabpy' datatype='string' hidden='true' name='[Calculation_899031098520301570]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SCRIPT_STR(&quot;&#10;&#10;if _arg1 &lt; 30:&#10;    return &apos;cheap&apos;&#10;elif _arg1 &lt;=80:&#10;    return &apos;good price&apos;&#10;else:&#10;    return &apos;expensive&apos;&#10;&quot;,&#10;ATTR([price])&#10;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Tabpy Price Per Review' datatype='real' hidden='true' name='[Calculation_899031098537631748]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SCRIPT_REAL(&quot;&#10;    return _arg1 / _arg2&#10;&quot;&#10;,&#10;sum([price]),&#10;sum([number_of_reviews])&#10;)'>
          <table-calc ordering-field='[federated.1xhyv3n1b7cbt81dh9f1w0sxiuib].[id]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Tabpy Availability Score' datatype='integer' name='[Calculation_899031098546065415]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SCRIPT_INT(&quot;&#10;result = []&#10;&#10;for days in _arg1:&#10;&#10;    if days &lt; 51:&#10;        result.append(1)&#10;    elif days &lt; 100:&#10;        result.append(2)&#10;    elif days &lt; 150:&#10;        result.append(3)&#10;    elif days &lt; 250:&#10;        result.append(4)&#10;    else:&#10;        result.append(5)&#10;return result&#10;&quot;,&#10;sum([availability_365])&#10;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='High Price Indicator Tabpy_corr' datatype='boolean' name='[High Price Indicator Tabpy (copy)_899031098514280449]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SCRIPT_BOOL(&quot;&#10;result = []&#10;for x in _arg1:&#10;    result.append(x &gt; 100)&#10;return result&#10;&quot;,&#10;SUM([price])&#10;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Tabpy Price Per Review (forloop)' datatype='real' name='[Price Per Review (copy)_899031098541559814]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SCRIPT_REAL(&quot;&#10;result = []&#10;for price, review in zip(_arg1, _arg2):&#10;    ratio = (price / review)&#10;    result.append(ratio)&#10;&#10;return result&#10;&quot;&#10;,&#10;sum([price]),&#10;sum([number_of_reviews])&#10;)'>
          <table-calc ordering-field='[federated.1xhyv3n1b7cbt81dh9f1w0sxiuib].[id]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Property Category Tabpy (copy)' datatype='string' name='[Property Category Tabpy (copy)_899031098528657411]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SCRIPT_STR(&quot;&#10;result = []&#10;for price in _arg1:&#10;    if price &lt; 30:&#10;        result.append(&apos;cheap&apos;)&#10;    elif price &lt;=80:&#10;         result.append(&apos;good price&apos;)&#10;    else:&#10;        result.append(&apos;expensive&apos;)&#10;return result&#10;&quot;,&#10;sum([price])&#10;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
